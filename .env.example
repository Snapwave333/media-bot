# AI Music Video SaaS - Environment Variables

# Database
DB_PASSWORD=your-secure-database-password

# Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production

# OpenAI API (Required for mood analysis and visual generation)
OPENAI_API_KEY=sk-your-openai-api-key

# Stripe (Required for payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_SINGLE_VIDEO=price_xxx
STRIPE_PRICE_SUBSCRIPTION=price_yyy

# Optional: Alternative video generation services
RUNWAY_API_KEY=your-runway-key
KAIBER_API_KEY=your-kaiber-key
REPLICATE_API_TOKEN=your-replicate-token
