# Application
DEBUG=False
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/musicvideo_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Services
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4

# Optional Video Generation Services
RUNWAY_API_KEY=your-runway-key
KAIBER_API_KEY=your-kaiber-key
REPLICATE_API_TOKEN=your-replicate-token

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_SINGLE_VIDEO=price_xxx
STRIPE_PRICE_SUBSCRIPTION=price_yyy

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TEMP_DIR=./temp
MAX_FILE_SIZE_MB=100
